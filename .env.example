# JARVIS ayarları. Bu dosyanın adını ".env" yap (kurulum bunu kendisi yapar) ve anahtarlarını yaz.
# Hepsi isteğe bağlı; en az birini girmen yeterli. Anahtarları uygulama içinden de girebilirsin: Ayarlar -> API anahtarları.

# Ücretsiz Gemini anahtarı (önerilir): https://aistudio.google.com/apikey
GEMINI_API_KEY=
JARVIS_MODEL=gemini-3.8-flash

# Ek ücretsiz sağlayıcılar (Gemini limiti dolunca sırayla kullanılır)
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Ses: auto = ElevenLabs (varsa) -> Gemini sesi -> Microsoft Ahmet
JARVIS_TTS=auto
# ElevenLabs (isteğe bağlı, ücretsiz plan): https://elevenlabs.io  -> sesi bulmak için ses_ayarla.bat
ELEVENLABS_API_KEY=
# Ücretsiz planda sadece ElevenLabs'ın varsayılan sesleri API'den çalışır. Daniel (İngiliz, ölçülü):
JARVIS_ELEVEN_VOICE=onwK4e9ZLuTAKqWW03F9

# Spotify API (isteğe bağlı; olmadan da Spotify'da şarkı açar). https://developer.spotify.com/dashboard
# SPOTIPY_CLIENT_ID=
# SPOTIPY_CLIENT_SECRET=
# SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
